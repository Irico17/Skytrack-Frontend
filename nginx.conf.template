server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Sin esto, nginx usa su default de 1 MB y rechaza con 413 cualquier carga de datos
    # (envíos/aeropuertos/vuelos) antes de que llegue al backend, que ya acepta 512 MB
    # (ver spring.servlet.multipart.max-*-size en application.properties) — igual que
    # deploy/vm/nginx-skytrack.conf para la VM del curso.
    client_max_body_size 512m;
    client_body_timeout 1800s;

    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 1800s;
        proxy_read_timeout 1800s;
    }

    location /ws/ {
        proxy_pass ${BACKEND_URL}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
